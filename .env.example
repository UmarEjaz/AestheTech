# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/aesthetech"

# NextAuth.js Configuration
# IMPORTANT: Generate a random secret for production
# You can generate one with: openssl rand -base64 32
#
# NEXTAUTH_URL:
#   DEV — leave it unset. `trustHost` (enabled only outside production) auto-detects
#         the host/port, so auth works on whatever port `next dev` binds to.
#   PROD — REQUIRED. Pin the real canonical domain, e.g.
#         NEXTAUTH_URL="https://app.aesthetech.com"
# NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-replace-in-production"

# Platform Super Admin (single break-glass operator).
# Credentials live ONLY in env — never in the database. Rules:
#   - Set BOTH or NEITHER (a half-configured admin is rejected at startup).
#   - Password must be at least 12 characters.
#   - The DB row (FK anchor for impersonation/audit) is created lazily on first login.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-min-12-chars"

# Redis (optional — app works without it)
# REDIS_URL="redis://localhost:6379"

# Application Environment
NODE_ENV="development"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Optional - for invoice emails, appointment reminders)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="AestheTech <noreply@aesthetech.app>"

# File Upload (Optional - if using cloud storage)
# UPLOAD_MAX_SIZE="5242880" # 5MB in bytes
# CLOUDINARY_URL="cloudinary://..."

# Rate Limiting (Optional)
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW_MS="60000"

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Sentry Error Tracking (Optional)
# SENTRY_DSN="https://...@sentry.io/..."

# Development Only
# NEXT_TELEMETRY_DISABLED="1"
